# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_DATABASE=futsal_bot
MYSQL_USER=futsal_bot
MYSQL_PASSWORD=your_password_here

# Payments page URL (optional, replaces Telegraph for payment status)
# Example: https://n-sun.ru/sport/payments.php
PAYMENTS_PAGE_URL=

# Shared signing key for links to the payments page. Set the SAME value here,
# in the other bot's .env and in web/config.php — then the page only opens
# links the bots produced, instead of anything reachable by editing ?event=.
# Leave empty to keep the page open to anyone with the link.
# PAYMENTS_SECRET=change_me_to_a_long_random_string

# Sign shown next to the kitty balance (/event_bank). One sign is all the bots
# use — they never convert between currencies.
# BANK_CURRENCY=₽

# ===========================================
# Telegram API access (for blocked regions)
# ===========================================
# Option 1: Cloudflare Worker proxy (preferred)
# Deploy a Telegram Bot API proxy Cloudflare Worker (e.g. a community
# one from GitHub) and set its URL.
# TG_API_URL=https://tg-api-proxy.your-domain.workers.dev

# Option 2: SOCKS/HTTP proxy
# TELEGRAM_PROXY=socks5://127.0.0.1:1080

# ===========================================
# Cross-Platform Sync (optional)
# ===========================================
# MAX bot token for updating linked MAX chat messages
# when participants change in Telegram.
# MAX_BOT_TOKEN=your_max_bot_token_here
