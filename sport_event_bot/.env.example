# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_DATABASE=futsal_bot
MYSQL_USER=futsal_bot
MYSQL_PASSWORD=your_password_here

# Payments page URL (optional, replaces Telegraph for payment status)
# Example: https://n-sun.ru/sport/payments.php
PAYMENTS_PAGE_URL=

# Links to the payments page are signed with a key generated per chat and kept
# in the database, so a link given to one group cannot be edited into another
# group's event. Nothing to configure here.

# Fallback label for the kitty (/event_bank). Each chat names its own currency
# with the amount — "/event_bank 120000 ₸" — and this is only used for a chat
# that never has. Nothing is converted between currencies.
# BANK_CURRENCY=₽

# ===========================================
# Telegram API access (for blocked regions)
# ===========================================
# Option 1: Cloudflare Worker proxy (preferred)
# Deploy a Telegram Bot API proxy Cloudflare Worker (e.g. a community
# one from GitHub) and set its URL.
# TG_API_URL=https://tg-api-proxy.your-domain.workers.dev

# Option 2: SOCKS/HTTP proxy
# TELEGRAM_PROXY=socks5://127.0.0.1:1080

# A host may publish IPv6 this server cannot actually reach — connections then
# hang until they time out. The bot checks for that at startup and switches to
# IPv4 on its own, so this is only an override:
#   TELEGRAM_FORCE_IPV4=1   always use IPv4
#   TELEGRAM_FORCE_IPV4=0   never check, use the system default
# Check by hand with: curl -4 ... https://<host>/ ; curl -6 ... https://<host>/

# ===========================================
# Cross-Platform Sync (optional)
# ===========================================
# MAX bot token for updating linked MAX chat messages
# when participants change in Telegram.
# MAX_BOT_TOKEN=your_max_bot_token_here
