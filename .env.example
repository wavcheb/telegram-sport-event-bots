# ===========================================
# Sport Event Bot Configuration
# ===========================================

# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Proxy for Telegram API (optional, for regions where Telegram is blocked)
# Supported formats:
#   SOCKS5: socks5://user:pass@host:port or socks5://host:port
#   HTTP:   http://host:port
#   HTTPS:  https://host:port
# TELEGRAM_PROXY=socks5://127.0.0.1:1080

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_DATABASE=futsal_bot
MYSQL_USER=futsal_bot
MYSQL_PASSWORD=your_password_here

# Payments page URL (optional, replaces Telegraph for payment status)
# Example: https://n-sun.ru/sport/payments.php
PAYMENTS_PAGE_URL=

# ===========================================
# Telegram Webhook Configuration (optional)
# ===========================================
# If set, bot runs in webhook mode instead of long polling.
# Use a Cloudflare Worker or direct HTTPS URL that proxies to the bot.
# TG_WEBHOOK_URL=https://your-tg-bot-worker.your-domain.workers.dev/tg-webhook
# TG_WEBHOOK_SECRET=change_me_to_random_secret_string
# TG_WEBHOOK_HOST=127.0.0.1
# TG_WEBHOOK_PORT=8181
# TG_WEBHOOK_PATH=/tg-webhook

# ===========================================
# MAX Sport Event Bot Configuration (optional)
# ===========================================
# MAX Bot Token (get from MasterBot in MAX messenger)
# MAX_BOT_TOKEN=your_max_bot_token_here

# MAX bot uses same database as Telegram bot for cross-platform features
# Data is separated by 'platform' field (telegram/max)

# ===========================================
# Cross-Platform Sync (optional)
# ===========================================
# For real-time sync between Telegram and MAX chats:
# - Telegram bot needs MAX_BOT_TOKEN to update MAX messages
# - MAX bot needs TG_BOT_TOKEN to update Telegram messages
# TG_BOT_TOKEN=your_telegram_bot_token_here

# ===========================================
# Tournament Bot Configuration (optional)
# ===========================================
# If not set, tournament bot will use TELEGRAM_BOT_TOKEN
# TOURNAMENT_BOT_TOKEN=your_tournament_bot_token_here

# Tournament bot can use same or different database
# If not set, uses MYSQL_* values above
# TOURNAMENT_MYSQL_HOST=localhost
# TOURNAMENT_MYSQL_DATABASE=tournament_bot
# TOURNAMENT_MYSQL_USER=tournament_bot
# TOURNAMENT_MYSQL_PASSWORD=your_password_here
