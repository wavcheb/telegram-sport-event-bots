# MAX Bot API Token (get from MasterBot in MAX messenger)
MAX_BOT_TOKEN=your_bot_token_here

# MySQL Database Configuration
# Use same database as Telegram bot for cross-platform features (chat linking)
MYSQL_HOST=localhost
MYSQL_DATABASE=futsal_bot
MYSQL_USER=futsal_bot
MYSQL_PASSWORD=your_password_here

# Payments page URL (optional, for showing payment status link)
# Example: https://n-sun.ru/sport/payments.php
PAYMENTS_PAGE_URL=
