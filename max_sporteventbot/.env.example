# MAX Bot API Token (get from MasterBot in MAX messenger)
MAX_BOT_TOKEN=your_bot_token_here

# ===========================================
# Webhook Configuration (REQUIRED for production)
# ===========================================
# Public HTTPS URL that MAX servers will POST updates to.
# Must be HTTPS with a valid (not self-signed) certificate.
# If not set, bot falls back to long polling (dev mode only).
#
# Example: your nginx proxies https://n-sun.ru/maxbot-webhook/ -> 127.0.0.1:8180
MAX_WEBHOOK_URL=https://n-sun.ru/maxbot-webhook/

# Secret token for webhook validation (5-256 chars, recommended)
# MAX sends it in X-Max-Bot-Api-Secret header; bot verifies it.
MAX_WEBHOOK_SECRET=change_me_to_random_secret_string

# Local aiohttp listener settings (behind nginx reverse proxy)
MAX_WEBHOOK_HOST=127.0.0.1
MAX_WEBHOOK_PORT=8180
MAX_WEBHOOK_PATH=/

# MySQL Database Configuration
# Use same database as Telegram bot for cross-platform features (chat linking)
MYSQL_HOST=localhost
MYSQL_DATABASE=futsal_bot
MYSQL_USER=futsal_bot
MYSQL_PASSWORD=your_password_here

# Payments page URL (optional, for showing payment status link)
# Example: https://n-sun.ru/sport/payments.php
PAYMENTS_PAGE_URL=

# Cross-Platform Sync (optional)
# Telegram bot token for real-time sync to linked Telegram chats
# When participants change in MAX, the linked Telegram message will be updated
# TG_BOT_TOKEN=your_telegram_bot_token_here

# Optional proxy for Telegram API (regions where Telegram is blocked)
# Supported formats:
#   SOCKS5: socks5://user:pass@host:port or socks5://host:port
#   HTTP:   http://host:port
#   HTTPS:  https://host:port
# For SOCKS proxies `requests[socks]` must be installed (PySocks).
# TELEGRAM_PROXY=socks5://127.0.0.1:1080

# Cloudflare Worker proxy for Telegram API (alternative to SOCKS proxy)
# Deploy a Telegram Bot API proxy Cloudflare Worker (e.g. a community
# one from GitHub) and set its URL here.
# TG_API_URL=https://tg-api-proxy.your-domain.workers.dev
