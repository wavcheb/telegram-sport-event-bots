# Tournament Bot Token (get from @BotFather)
# Falls back to TELEGRAM_BOT_TOKEN if not set.
TOURNAMENT_BOT_TOKEN=your_bot_token_here

# MySQL Database Configuration
# Falls back to MYSQL_* if TOURNAMENT_MYSQL_* not set.
TOURNAMENT_MYSQL_HOST=localhost
TOURNAMENT_MYSQL_DATABASE=tournament_bot
TOURNAMENT_MYSQL_USER=tournament_bot
TOURNAMENT_MYSQL_PASSWORD=your_password_here

# ===========================================
# Telegram API access (for blocked regions)
# ===========================================
# Option 1: Cloudflare Worker proxy (preferred)
# TG_API_URL=https://tg-api-proxy.your-domain.workers.dev

# Option 2: SOCKS/HTTP proxy
# TELEGRAM_PROXY=socks5://127.0.0.1:1080
